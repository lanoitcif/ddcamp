# Copy to .env and fill in your LiteLLM master key (proxy at 127.0.0.1:4000).
# .env is gitignored — never commit real keys.
# No VITE_ prefix on purpose: Vite must never expose this to the browser bundle.
LITELLM_KEY=sk-your-litellm-key-here

# Optional: default AI model the DM Console starts on. A model NAME is not a
# secret, so VITE_ is fine here. Must match a model_name your LiteLLM proxy
# serves (see litellm.config.example.yaml). Defaults to 'fast-local' if unset.
# VITE_DEFAULT_LLM_MODEL=fast-local
